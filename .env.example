# Groq Cloud Configuration (LangChain ChatGroq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=1024

# Model Configuration
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Elasticsearch Configuration (Session 4 BM25 Retreival)
USE_ELASTICSEARCH=false
ELASTICSEARCH_URL=http://localhost:9200
# For Elastic Cloud (from Week 2 S4):
# ELASTICSEARCH_URL=https://your-deployment-id.es.region.gcp.elastic.cloud:443
# ELASTICSEARCH_API_KEY=your_base64_api_key_here
ELASTICSEARCH_INDEX=fincon_child_chunks
